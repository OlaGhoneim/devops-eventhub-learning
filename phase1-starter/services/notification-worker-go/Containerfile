FROM golang:1.22 AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY main.go .

RUN CGO_ENABLED=0 go build -o notification-worker .

FROM alpine:3.20

WORKDIR /app

COPY --from=builder /app/notification-worker .

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD kill -0 1 || exit 1

CMD ["./notification-worker"]
